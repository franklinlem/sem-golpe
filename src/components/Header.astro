---
<header class="site-header">
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>
  <div class="container nav">
    <a href="/" class="brand" aria-label="Sem Golpe — início">
      <img class="brand-logo" src="/marca/logo-v1.webp" width="180" height="60" alt="Sem Golpe" fetchpriority="high" />
    </a>
    <button class="menu-button" aria-expanded="false" aria-controls="nav-links">Menu</button>
    <nav id="nav-links" class="nav-links" aria-label="Navegação principal">
      <a href="/identificar-golpe/">Identificar golpe</a>
      <a href="/golpes/">Tipos de golpe</a>
      <a href="/ferramentas/">Ferramentas</a>
      <a href="/sobre/">Sobre</a>
      <a class="nav-urgent" href="/fui-vitima/">Fui vítima agora</a>
    </nav>
  </div>
</header>
<script>
  const button=document.querySelector('.menu-button');
  const nav=document.querySelector('#nav-links');
  button?.addEventListener('click',()=>{const open=nav?.classList.toggle('open')??false;button.setAttribute('aria-expanded',String(open));});
</script>

