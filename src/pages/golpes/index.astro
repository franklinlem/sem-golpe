---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { golpes } from '@/data/golpes';
---
<BaseLayout noindex title="Tipos de golpe" description="Fichas beta sobre padrões de fraudes digitais, bancárias, em veículos, leilões, relacionamentos e redes sociais.">
  <div class="container breadcrumbs"><a href="/">Início</a> / Tipos de golpe</div>
  <section class="page-hero"><div class="container"><span class="eyebrow">Biblioteca beta</span><h1>Fichas introdutórias sobre golpes.</h1><p class="hero-copy">Estas fichas estão em revisão editorial e fora do sitemap. Elas não confirmam se uma situação específica é fraude. Para agir, consulte os canais oficiais e as orientações de emergência.</p><a class="button secondary" href="/onde-denunciar/">Encontrar canais oficiais</a></div></section>
  <section class="tool-section"><div class="container grid">{golpes.map((golpe) => <a class="card card-link" href={`/golpes/${golpe.slug}/`}><div class="card-icon">{golpe.icon}</div><span class="tag">{golpe.accent}</span><h3>{golpe.title}</h3><p>{golpe.short}</p><span class="orange">Abrir ficha beta →</span></a>)}</div></section>
</BaseLayout>
