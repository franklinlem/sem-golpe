---
import BaseLayout from '@/layouts/BaseLayout.astro';
const questions=[['urgencia','A pessoa criou urgência, medo ou ameaça?'],['segredo','Pediu segredo ou tentou impedir que você consultasse alguém?'],['pagamento','Pediu Pix, taxa, código, senha ou pagamento para terceiro?'],['canal','O contato veio de número, perfil ou endereço diferente do habitual?'],['vantagem','Prometeu prêmio, lucro ou vantagem muito acima do normal?'],['controle','Pediu instalação de aplicativo ou compartilhamento de tela?']];
---
<BaseLayout title="Identificador educativo de sinais" description="Responda perguntas simples para reconhecer sinais comuns de engenharia social e golpes."><div class="container breadcrumbs"><a href="/">Início</a> / Identificar sinais</div><section class="page-hero"><div class="container"><span class="eyebrow">Ferramenta educativa</span><h1>Quantos sinais de risco estão presentes?</h1><p class="hero-copy">Esta ferramenta não confirma se algo é golpe. Ela ajuda você a pausar e verificar a abordagem por outro canal.</p></div></section><section style="padding-top:10px"><div class="container"><form id="risk-form" class="card tool-shell"><div class="progress" aria-hidden="true"><span id="progress-bar"></span></div><p id="counter">0 de {questions.length} respostas marcadas</p><div class="choice-grid">{questions.map(([id,label])=><label class="choice"><input type="checkbox" name={id}/><span><strong>{label}</strong><br/><small>Marque se isso aconteceu na abordagem.</small></span></label>)}</div><div class="actions"><button class="button" type="submit">Ver orientação</button><button class="button secondary" type="reset">Limpar</button></div><div id="risk-result" class="result" role="status" aria-live="polite"></div></form><div class="disclaimer" style="margin-top:22px">Suas respostas não são enviadas nem armazenadas pelo Sem Golpe. Evite usar a ferramenta em um aparelho que possa estar sob controle remoto.</div></div></section></BaseLayout>
<script>
const form=document.querySelector<HTMLFormElement>('#risk-form')!;const boxes=[...form.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];const result=document.querySelector('#risk-result')!;const counter=document.querySelector('#counter')!;const bar=document.querySelector<HTMLElement>('#progress-bar')!;
function update(){const n=boxes.filter(x=>x.checked).length;counter.textContent=`${n} de ${boxes.length} respostas marcadas`;bar.style.width=`${n/boxes.length*100}%`;}
boxes.forEach(x=>x.addEventListener('change',update));form.addEventListener('reset',()=>setTimeout(()=>{update();result.classList.remove('show')},0));form.addEventListener('submit',e=>{e.preventDefault();const n=boxes.filter(x=>x.checked).length;const level=n>=4?'Muitos sinais de risco':n>=2?'Vários sinais de risco':'Poucos sinais identificados';const msg=n>=2?'Não faça pagamentos, não instale aplicativos e confirme a história por um canal oficial encontrado por você.':'A ausência desses sinais não prova que a abordagem seja legítima. Confirme identidade, endereço e pagamento de forma independente.';result.innerHTML=`<span class="badge">${level}</span><h2 style="margin-top:14px">Pare antes de continuar</h2><p>${msg}</p><a class="button" href="/fui-vitima/">Ver próximos passos</a>`;result.classList.add('show');result.scrollIntoView({behavior:'smooth',block:'nearest'});});
</script>
