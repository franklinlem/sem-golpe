---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Verificar link suspeito" description="Examine o domínio de um link suspeito localmente, sem abrir o endereço.">
  <div class="container breadcrumbs"><a href="/">Início</a> / Verificar link</div>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Não abrimos o endereço</span>
      <h1>Veja o domínio real antes de clicar.</h1>
      <p class="hero-copy">Cole o link. A análise acontece apenas neste navegador e destaca alguns sinais técnicos que merecem atenção.</p>
    </div>
  </section>
  <section class="tool-section">
    <div class="container">
      <form id="url-form" class="card tool-shell">
        <div class="field">
          <label for="suspect-url">Link ou domínio suspeito</label>
          <input id="suspect-url" type="text" inputmode="url" autocomplete="off" placeholder="exemplo: banco.example/confirmar" required />
          <small>Não cole links com senhas, tokens ou dados pessoais.</small>
        </div>
        <div class="actions">
          <button class="button" type="submit">Examinar sem abrir</button>
          <button class="button secondary" type="reset">Limpar</button>
        </div>
        <div id="url-result" class="result" role="status" aria-live="polite"></div>
      </form>
      <div class="disclaimer" style="margin-top:22px"><strong>Importante:</strong> cadeado e HTTPS não provam que um site é legítimo. Procure o endereço oficial por conta própria.</div>
    </div>
  </section>
</BaseLayout>
<script>
import { analyzeLink } from '@/lib/analyze-link.js';

const form = document.querySelector<HTMLFormElement>('#url-form')!;
const input = document.querySelector<HTMLInputElement>('#suspect-url')!;
const out = document.querySelector<HTMLElement>('#url-result')!;

function addText(parent: HTMLElement, tag: string, text: string, className = '') {
  const element = document.createElement(tag);
  element.textContent = text;
  if (className) element.className = className;
  parent.append(element);
  return element;
}

function renderError(message: string) {
  out.replaceChildren();
  addText(out, 'h2', 'Não foi possível examinar esse endereço');
  addText(out, 'p', message);
  out.classList.add('show');
}

form.addEventListener('reset', () => setTimeout(() => {
  out.replaceChildren();
  out.classList.remove('show');
}, 0));

form.addEventListener('submit', (event) => {
  event.preventDefault();
  const analysis = analyzeLink(input.value);
  if (!analysis.ok) {
    renderError(analysis.message);
    return;
  }

  out.replaceChildren();
  addText(out, 'span', 'Análise local', 'badge');
  const hostname = addText(out, 'h2', analysis.hostname, 'result-hostname');
  hostname.style.marginTop = '14px';
  addText(out, 'p', `Protocolo: ${analysis.protocol}`);

  if (analysis.flags.length) {
    addText(out, 'h3', 'Sinais técnicos encontrados');
    const list = document.createElement('ul');
    for (const flag of analysis.flags) addText(list, 'li', flag);
    out.append(list);
  } else {
    addText(out, 'p', 'Nenhum dos sinais técnicos avaliados apareceu. Isso não comprova legitimidade.');
  }

  addText(out, 'p', 'Confirme o domínio em um canal oficial que você encontrou por conta própria.');
  out.classList.add('show');
});
</script>
